{
  "alias": "rustid-config",
  "description": "rustid OIDC discovery",
  "server": {
    "discoveryUrl": "https://localhost:9443/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "conformance-suite",
    "client_secret": "conformance-secret-long-enough-for-hs256"
  },
  "browser": [
    {
      "match": "https://localhost:9443/connect/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://localhost:9443/Account/Login*",
          "commands": [
            [
              "text",
              "id",
              "username",
              "alice",
              "optional"
            ],
            [
              "text",
              "id",
              "password",
              "alice",
              "optional"
            ],
            [
              "click",
              "xpath",
              "//button[@value='login']"
            ]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "https://localhost:9443/consent*",
          "commands": [
            [
              "click",
              "xpath",
              "//button[@value='yes']"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    },
    {
      "match": "https://localhost:9443/connect/endsession*",
      "tasks": [
        {
          "task": "Confirm sign-out",
          "optional": true,
          "match": "https://localhost:9443/Account/Logout*",
          "commands": [
            [
              "click",
              "xpath",
              "//button[@type='submit']",
              "optional"
            ]
          ]
        },
        {
          "task": "Wait for the redirect back",
          "optional": true,
          "match": "https://localhost:9443/Account/Logout*",
          "commands": [
            [
              "wait",
              "contains",
              "/test/*/post",
              10
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/post*"
        }
      ]
    }
  ],
  "override": {}
}
