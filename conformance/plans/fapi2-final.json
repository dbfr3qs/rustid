              "click",
              "xpath",
              "//button[@value='login']"
            ]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "https://localhost:9444/consent*",
          "commands": [
            [
              "click",
              "xpath",
              "//button[@value='yes']"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
