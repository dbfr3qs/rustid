{
  "signing_keys": [
    {
      "kid": "saml-idp-rsa",
      "alg": "RS256",
      "key_file": "../saml/idp/idp-rsa.key.pem",
      "cert_file": "../saml/idp/idp-rsa.cert.pem"
    },
    {
      "kid": "saml-idp-rsa-2",
      "alg": "RS256",
      "key_file": "../validation-cert-key.pem",
      "cert_file": "../validation-cert.pem"
    },
    {
      "kid": "saml-idp-ec",
      "alg": "ES256",
      "key_file": "../saml/idp/idp-ec.key.pem",
      "cert_file": "../saml/idp/idp-ec.cert.pem"
    },
    {
      "kid": "fixture-ec-p256",
      "alg": "ES256",
      "key_file": "../signing-ec-p256.pem"
    }
  ],
  "resources_file": "../resources.json",
  "clients_file": "../clients.json",
  "placeholders": {
    "password_grant": true
  },
  "protocol": {
    "issuer_uri": "https://idsrv.test",
    "key_management": {
      "enabled": false
    }
  },
  "reference_ui": {
    "enabled": true,
    "users_file": "../users.json",
    "default_user": "alice"
  },
  "localization": {
    "supported_ui_cultures": [
      "en-US",
      "nb-NO"
    ]
  },
  "data_protection": {
    "keys": [
      {
        "id": "fixture",
        "secret": "cnVzdGlkIGZpeHR1cmUgZGF0YSBwcm90ZWN0aW9uISE="
      }
    ]
  },
  "saml": {
    "enabled": true,
    "service_providers_file": "../saml-service-providers.json",
    "entity_id": "https://idp.example.com/custom/saml",
    "want_authn_requests_signed": false,
    "supported_name_id_formats": [
      "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
      "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent"
    ],
    "metadata": {
      "cache_duration": "01:30:00",
      "expiry_duration": "30.00:00:00"
    },
    "endpoints": {
      "single_sign_on_service_path": "/custom/sso"
    }
  }
}
